{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "exclude": ["node_modules", "**/node_modules/*", "chrome-user-data", "dist", "**/dist/*"]
}
