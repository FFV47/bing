{
  "name": "bing-auto-search",
  "version": "1.0.0",
  "description": "Application that opens browser and searches on Bing at determined intervals",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bing",
    "search",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "2.21.0",
    "puppeteer": "25.10.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
