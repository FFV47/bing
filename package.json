{
  "name": "bing-auto-search",
  "version": "1.0.0",
  "description": "Application that opens browser and searches on Bing at determined intervals",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "generate": "node src/generateTermsGemini.js",
    "generate:mobile": "node src/generateTermsGemini.js --mobile",
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "bing",
    "search",
    "automation"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@google/genai": "2.30.0",
    "puppeteer-core": "25.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
